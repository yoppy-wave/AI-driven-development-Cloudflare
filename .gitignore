# ローカル環境ごとの設定や認証情報を含むため、リポジトリでは管理しない。
.env
.env.*
# 共有用の設定テンプレートは管理対象に残す。
!.env.example

# Python の仮想環境、実行時キャッシュ、テスト・静的解析で生成されるファイルのため管理しない。
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# 依存パッケージおよびビルド・テストで再生成できる成果物のため管理しない。
node_modules/
.next/
dist/
build/
coverage/
*.tsbuildinfo
cdk.out/

# OS が自動生成するメタデータと、実行時に出力されるログのため管理しない。
.DS_Store
Thumbs.db
*.log
*.log.[0-9]*
# Defensive exclusions if local proxy state/logs are copied into the workspace.
.devcontainer/squid/.local/
